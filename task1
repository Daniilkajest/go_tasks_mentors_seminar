#Задание 1. Калькулятор с проверкой
#Пользователь вводит два числа и одну из арифметических операций: +, -, * или /.
#Реализуйте программу, которая выполняет выбранное вычисление. При делении предусмотрите проверку деления на ноль.
#Отрабатываемые навыки: switch, if, арифметические операции.

package main

import (
	"fmt"
)

func main() {
	var a, b float64
	var op string

	fmt.Println("Введите первое число, операцию (+, -, *, /) и второе число через пробел:")
	fmt.Scan(&a, &op, &b)

	switch op {
	case "+":
		fmt.Printf("Результат: %.2f\n", a+b)
	case "-":
		fmt.Printf("Результат: %.2f\n", a-b)
	case "*":
		fmt.Printf("Результат: %.2f\n", a*b)
	case "/":
		if b == 0 {
			fmt.Println("Ошибка: деление на ноль!")
		} else {
			fmt.Printf("Результат: %.2f\n", a/b)
		}
	default:
		fmt.Println("Ошибка: неизвестная операция")
	}
}
